# 主模型默认沿用 DeepSeek；API key 仅为占位，请勿提交真实值。
TRIVAE_MODEL_PROVIDER=deepseek
TRIVAE_MODEL_NAME=deepseek-flash
TRIVAE_MODEL_BASE_URL=https://api.deepseek.com
TRIVAE_MODEL_API_KEY=

# ChatGPT 订阅模式：先运行 trivae auth login --provider chatgpt，
# 再运行 trivae auth models --provider chatgpt，从返回目录复制实际 slug。
# 仅替换上面的 PROVIDER/NAME；此模式忽略传统 API key 和 BASE_URL，
# 始终访问官方 https://api.openai.com/v1，不在 .env 存放 OAuth token。
# TRIVAE_MODEL_PROVIDER=chatgpt-plan
# TRIVAE_MODEL_NAME=<slug-from-auth-models>

# 本地 Agent 预算仍有效；订阅协议不发送 server max tokens/temperature。
# 未知 GPT context 沿用现有 dynamic budget；不按名称猜测 context 或 reasoning 能力。
TRIVAE_MAX_TURNS=8
TRIVAE_MAX_TOOL_ROUNDS=3
TRIVAE_TOOL_RESULT_BUDGET_MODE=dynamic

# 需要充分检索与综合时，可在已确认模型 context 容量后显式增加本地预算。
# 例如当前已登记 500000 context 的 Plan 模型可使用以下两项；未知容量不能覆盖证据池。
# 6 轮工具加一次最终综合仍在上面的 8 次执行轮数内；这是上限，不要求每题用满。
# TRIVAE_MAX_TOOL_ROUNDS=6
# TRIVAE_RUN_TOOL_EVIDENCE_BUDGET=200000

# Router Jev 专用 OpenRouter 凭据，仅从环境读取；请勿提交真实值。
OPENROUTER_API_KEY=

# Jev 只服务 Router ambiguous decision，不影响 TRIVAE_MODEL_* 主模型。
# 注意主模型拼写为 TRIVAE；历史 Jev 变量按现有契约保留 TRIVIAE。
TRIVIAE_ROUTER_JEV_ENABLED=true
TRIVIAE_ROUTER_JEV_MODEL=typesafe/jev-1.13
TRIVIAE_ROUTER_JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
TRIVIAE_ROUTER_JEV_MODE=shadow
