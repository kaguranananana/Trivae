# Model identity and provider settings live in config/models.yaml.
# Keep secrets here; ChatGPT OAuth credentials stay in the local Auth Store.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
LANGSMITH_API_KEY=

# Select a named profile for ordinary queries. Eval uses evaluation.agent/judge by default.
# TRIVAE_MODEL_ID=gpt-plus
# TRIVAE_MODELS_CONFIG=config/models.yaml

# 本地 Agent 预算仍有效；订阅协议不发送 server max tokens/temperature。
# 未知 GPT context 沿用现有 dynamic budget；不按名称猜测 context 或 reasoning 能力。
TRIVAE_MAX_TURNS=8
TRIVAE_MAX_TOOL_ROUNDS=6
TRIVAE_TOOL_RESULT_BUDGET_MODE=dynamic

# 需要充分检索与综合时，可在已确认模型 context 容量后显式增加本地预算。
# 例如当前已登记 500000 context 的 Plan 模型可使用下方证据池配置；未知容量不能覆盖。
# 6 轮工具加一次最终综合仍在上面的 8 次执行轮数内；这是上限，不要求每题用满。
# TRIVAE_RUN_TOOL_EVIDENCE_BUDGET=200000

# Jev 只服务 Router ambiguous decision，不影响 TRIVAE_MODEL_* 主模型。
# 注意主模型拼写为 TRIVAE；历史 Jev 变量按现有契约保留 TRIVIAE。
TRIVIAE_ROUTER_JEV_ENABLED=true
TRIVIAE_ROUTER_JEV_MODEL=typesafe/jev-1.13
TRIVIAE_ROUTER_JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
TRIVIAE_ROUTER_JEV_MODE=shadow
