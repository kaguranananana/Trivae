.obsidian/

data/raw/
data/*.sqlite3
# 导入互斥锁保留原 inode，仅在本地使用，不纳入版本控制。
data/*.sqlite3.import-once.lock
# 真实 retrieval packet/标签/审计队列包含私有聊天正文，只允许本地保存。
data/evaluation/
# TUI /export 产出包含会话与聊天内容，仅本地保存。
data/exports/
# 日报正文、模型输入及邮件状态包含私有群聊材料，只在本机保存。
data/digests/
data/*.digest.lock

# Web frontend（构建产物按需 pnpm -C web build 生成；trivae web 自动探测 web/dist）
web/node_modules/
web/dist/

# TS 增量构建缓存
web/*.tsbuildinfo
